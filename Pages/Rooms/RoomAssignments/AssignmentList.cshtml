
@page
@model DormitoryManagement.Pages.Rooms.RoomAssignments.AssignmentListModel

@{
    ViewData["Title"] = "Room Assignments";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Room Assignments</h1>
            <p class="text-secondary mb-0">
                View and manage students assigned to dormitory rooms.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="/Rooms/RoomAssignments/CreateAssignment"
               class="btn btn-primary">
                + New Assignment
            </a>

            <a href="/" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">
                Registered Assignments (@Model.Assignments.Count)
            </h2>

            @if (Model.Assignments.Count == 0)
            {
                <p class="text-secondary mb-0">
                    No room assignments found.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Assignment ID</th>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>Room ID</th>
                                <th>Room Number</th>
                                <th>Check-in Date</th>
                                <th>Check-out Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments)
                            {
                                <tr>
                                    <td>@assignment.AssignmentId</td>
                                    <td>@assignment.StudentId</td>
                                    <td>@assignment.StudentName</td>
                                    <td>@assignment.RoomId</td>
                                    <td>@assignment.RoomNumber</td>
                                    <td>@assignment.CheckInDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @(assignment.CheckOutDate?.ToString("yyyy-MM-dd") ?? "—")
                                    </td>
                                    <td>
                                        @if (assignment.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (assignment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @assignment.Status
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-page="/Rooms/RoomAssignments/EditAssignment"
                                               asp-route-id="@assignment.AssignmentId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            @if (assignment.Status == "Active")
                                            {
                                                <form method="post"
                                                      asp-page-handler="Cancel"
                                                      asp-route-id="@assignment.AssignmentId"
                                                      onsubmit="return confirm('Are you sure you want to cancel this room assignment?');">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Cancel
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
