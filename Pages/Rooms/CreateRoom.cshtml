
@page
@model DormitoryManagement.Pages.Rooms.CreateRoomModel

@{
    ViewData["Title"] = "Add Room";
}

<div class="container py-4">
    <h1 class="fw-bold mb-2">Add Room</h1>
    <p class="text-secondary mb-4">
        Enter the details for a new dormitory room.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Room.RoomNumber" class="form-label">
                        Room Number
                    </label>
                    <input asp-for="Room.RoomNumber" class="form-control" />
                    <span asp-validation-for="Room.RoomNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Room.Floor" class="form-label">
                        Floor
                    </label>
                    <input asp-for="Room.Floor" type="number"
                           class="form-control" />
                    <span asp-validation-for="Room.Floor"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Room.RoomType" class="form-label">
                        Room Type
                    </label>
                    <select asp-for="Room.RoomType" class="form-select">
                        <option value="">Select room type</option>
                        <option value="Single">Single</option>
                        <option value="Double">Double</option>
                        <option value="Triple">Triple</option>
                    </select>
                    <span asp-validation-for="Room.RoomType"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Room.Capacity" class="form-label">
                        Capacity
                    </label>
                    <input asp-for="Room.Capacity" type="number"
                           min="1" class="form-control" />
                    <span asp-validation-for="Room.Capacity"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Room
                </button>

                <a asp-page="/Rooms/RoomList"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
