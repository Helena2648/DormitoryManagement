@page
@model DormitoryManagement.Pages.Rooms.DeleteRoomModel

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container py-4">
    <h1 class="fw-bold mb-2">Delete Room</h1>

    <p class="text-secondary mb-4">
        Review the room details before confirming deletion.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 text-danger mb-3">
                Are you sure you want to delete this room?
            </h2>

            <dl class="row">
                <dt class="col-sm-3">Room ID</dt>
                <dd class="col-sm-9">@Model.Room.RoomId</dd>

                <dt class="col-sm-3">Room Number</dt>
                <dd class="col-sm-9">@Model.Room.RoomNumber</dd>

                <dt class="col-sm-3">Floor</dt>
                <dd class="col-sm-9">
                    @(Model.Room.Floor?.ToString() ?? "—")
                </dd>

                <dt class="col-sm-3">Room Type</dt>
                <dd class="col-sm-9">
                    @(Model.Room.RoomType ?? "—")
                </dd>

                <dt class="col-sm-3">Capacity</dt>
                <dd class="col-sm-9">@Model.Room.Capacity</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Room.RoomId" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-page="/Rooms/RoomList"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>