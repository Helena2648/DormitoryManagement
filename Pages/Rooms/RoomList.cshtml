
@page
@model DormitoryManagement.Pages.Rooms.RoomListModel

@{
    ViewData["Title"] = "Room Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Room Management</h1>
            <p class="text-secondary mb-0">
                View dormitory rooms, floors, types, and capacities.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-page="/Rooms/CreateRoom" class="btn btn-primary">
                + Add Room
            </a>

            <a href="/" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">
                Registered Rooms (@Model.Rooms.Count)
            </h2>

            @if (Model.Rooms.Count == 0)
            {
                <p class="text-secondary mb-0">
                    No room records found.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Room ID</th>
                                <th>Room Number</th>
                                <th>Floor</th>
                                <th>Room Type</th>
                                <th>Capacity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var room in Model.Rooms)
                            {
                                <tr>
                                    <td>@room.RoomId</td>
                                    <td>@room.RoomNumber</td>
                                    <td>@(room.Floor?.ToString() ?? "—")</td>
                                    <td>@(room.RoomType ?? "—")</td>
                                    <td>@room.Capacity</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-page="/Rooms/EditRoom"
                                               asp-route-id="@room.RoomId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-page="/Rooms/DeleteRoom"
                                               asp-route-id="@room.RoomId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
