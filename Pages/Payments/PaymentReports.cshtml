@page
@model DormitoryManagement.Pages.Payments.PaymentReportsModel

@{
    ViewData["Title"] = "Payment Reports";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Payment Reports</h2>
            <p class="text-muted">
                Review collected revenue, outstanding payments, and monthly income.
            </p>
        </div>

        <div>
            <a href="/Payments/PaymentList" class="btn btn-primary">
                Payment Management
            </a>
            <a href="/" class="btn btn-secondary ms-2">
                Dashboard
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-body">
                    <h6 class="text-muted">Total Collected</h6>
                    <h2 class="text-success">
                        @Model.TotalCollected.ToString("N2")
                    </h2>
                    <p class="text-muted mb-0">
                        Payments marked as Paid
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-danger">
                <div class="card-body">
                    <h6 class="text-muted">Outstanding Payments</h6>
                    <h2 class="text-danger">
                        @Model.OutstandingPayments.ToString("N2")
                    </h2>
                    <p class="text-muted mb-0">
                        Payments not marked as Paid
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-body">
                    <h6 class="text-muted">Payment Records</h6>
                    <h2 class="text-primary">
                        @Model.TotalPaymentRecords
                    </h2>
                    <p class="text-muted mb-0">
                        Total recorded payments
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Status Breakdown -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Payment Status Summary</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Payment Status</th>
                            <th>Number of Records</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <span class="badge bg-success">Paid</span>
                            </td>
                            <td>@Model.PaidCount</td>
                        </tr>
                        <tr>
                            <td>
                                <span class="badge bg-warning text-dark">Pending</span>
                            </td>
                            <td>@Model.PendingCount</td>
                        </tr>
                        <tr>
                            <td>
                                <span class="badge bg-danger">Overdue</span>
                            </td>
                            <td>@Model.OverdueCount</td>
                        </tr>
                        <tr>
                            <td>
                                <span class="badge bg-secondary">Unpaid</span>
                            </td>
                            <td>@Model.UnpaidCount</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Monthly Revenue -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Monthly Revenue</h5>
        </div>

        <div class="card-body">
            @if (Model.MonthlyRevenue.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No paid payment records are available for the monthly report.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Month</th>
                                <th>Paid Records</th>
                                <th>Total Collected</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var month in Model.MonthlyRevenue)
                            {
                                <tr>
                                    <td>@month.MonthName</td>
                                    <td>@month.PaymentCount</td>
                                    <td class="fw-bold text-success">
                                        @month.Amount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr class="table-light">
                                <th colspan="2">Total Collected</th>
                                <th class="text-success">
                                    @Model.TotalCollected.ToString("N2")
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>