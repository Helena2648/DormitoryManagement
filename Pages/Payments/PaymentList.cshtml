@page
@model DormitoryManagement.Pages.Payments.PaymentListModel

@{
    ViewData["Title"] = "Payment Management";
}

<div class="container-fluid mt-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Payment Management</h2>
            <p class="text-muted">
                View, search, and manage dormitory payments.
            </p>
        </div>

        <div>
            <a href="/Payments/CreatePayment" class="btn btn-primary">
                + Add Payment
            </a>

            <a href="/" class="btn btn-secondary ms-2">
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Search and Filter Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Search and Filter Payments</h5>
        </div>

        <div class="card-body">
            <form method="get" action="/Payments/PaymentList">
                <div class="row g-3">
                    <!-- Search -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="SearchTerm" class="form-label">
                            Search
                        </label>

                        <input type="text"
                               id="SearchTerm"
                               name="SearchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Payment ID or room number" />
                    </div>

                    <!-- Status -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="StatusFilter" class="form-label">
                            Payment Status
                        </label>

                        <select id="StatusFilter"
                                name="StatusFilter"
                                class="form-select">
                            <option value="">All Statuses</option>

                            <option value="Paid"
                                    selected="@(Model.StatusFilter == "Paid")">
                                Paid
                            </option>

                            <option value="Pending"
                                    selected="@(Model.StatusFilter == "Pending")">
                                Pending
                            </option>

                            <option value="Overdue"
                                    selected="@(Model.StatusFilter == "Overdue")">
                                Overdue
                            </option>

                            <option value="Unpaid"
                                    selected="@(Model.StatusFilter == "Unpaid")">
                                Unpaid
                            </option>
                        </select>
                    </div>

                    <!-- Start Date -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="StartDate" class="form-label">
                            From Date
                        </label>

                        <input type="date"
                               id="StartDate"
                               name="StartDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd",
                                   System.Globalization.CultureInfo.InvariantCulture))"
                               class="form-control" />
                    </div>

                    <!-- End Date -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="EndDate" class="form-label">
                            To Date
                        </label>

                        <input type="date"
                               id="EndDate"
                               name="EndDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd",
                                   System.Globalization.CultureInfo.InvariantCulture))"
                               class="form-control" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Search / Filter
                    </button>

                    <a href="/Payments/PaymentList"
                       class="btn btn-outline-secondary">
                        Reset Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Filter Validation -->
    @if (!string.IsNullOrWhiteSpace(Model.FilterError))
    {
        <div class="alert alert-warning" role="alert">
            @Model.FilterError
        </div>
    }

    <!-- Payment Records -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Payment Records</h5>

            <span class="badge bg-secondary">
                Records: @Model.Payments.Count
            </span>
        </div>

        <div class="card-body">
            @if (Model.FilterError != null)
            {
                <p class="text-muted mb-0">
                    Correct the date range to view payment records.
                </p>
            }
            else if (Model.Payments.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No payments match your search or filter criteria.
                    Try changing your filters or select Reset Filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Payment ID</th>
                                <th>Room</th>
                                <th>Rental Fee</th>
                                <th>Water Fee</th>
                                <th>Electricity Fee</th>
                                <th>Total</th>
                                <th>Method</th>
                                <th>Payment Date</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>@payment.PaymentId</td>

                                    <td>@payment.RoomNumber</td>

                                    <td>@payment.RentalFee.ToString("N2")</td>

                                    <td>@payment.WaterFee.ToString("N2")</td>

                                    <td>@payment.ElectricityFee.ToString("N2")</td>

                                    <td class="fw-bold">
                                        @payment.Total.ToString("N2")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(payment.PaymentMethod)
                                            ? "—"
                                            : payment.PaymentMethod)
                                    </td>

                                    <td>
                                        @payment.PaymentDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @if (payment.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if (payment.PaymentStatus == "Overdue")
                                        {
                                            <span class="badge bg-danger">
                                                Overdue
                                            </span>
                                        }
                                        else if (payment.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @payment.PaymentStatus
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(payment.Notes)
                                            ? "—"
                                            : payment.Notes)
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">
                                            <a href="/Payments/EditPayment?id=@payment.PaymentId"
                                               class="btn btn-outline-primary btn-sm">
                                                Edit
                                            </a>

                                            <a href="/Payments/DeletePayment?id=@payment.PaymentId"
                                               class="btn btn-outline-danger btn-sm">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>