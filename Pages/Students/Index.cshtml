@page
@model DormitoryManagement.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Student Management";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Student Management</h1>
            <p class="text-secondary mb-0">
                View, search, and manage registered dormitory students.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-page="/Students/Create" class="btn btn-primary">
                + Add Student
            </a>

            <a asp-page="/Index" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Success and Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">Search and Filter Students</h2>
        </div>

        <div class="card-body">
            <form method="get">
                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-12 col-md-4">
                        <label for="SearchTerm" class="form-label">
                            Search Student
                        </label>

                        <input type="text"
                               id="SearchTerm"
                               name="SearchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Enter student ID or name" />
                    </div>

                    <!-- Room Assignment Filter -->
                    <div class="col-12 col-md-4">
                        <label for="AssignmentFilter" class="form-label">
                            Room Assignment
                        </label>

                        <select id="AssignmentFilter"
                                name="AssignmentFilter"
                                class="form-select">
                            <option value=""
                                    selected="@(string.IsNullOrEmpty(Model.AssignmentFilter))">
                                All Assignments
                            </option>

                            <option value="Assigned"
                                    selected="@(Model.AssignmentFilter == "Assigned")">
                                Currently Assigned
                            </option>

                            <option value="NotAssigned"
                                    selected="@(Model.AssignmentFilter == "NotAssigned")">
                                Not Assigned
                            </option>
                        </select>
                    </div>

                    <!-- Student Status Filter -->
                    <div class="col-12 col-md-4">
                        <label for="StatusFilter" class="form-label">
                            Student Status
                        </label>

                        <select id="StatusFilter"
                                name="StatusFilter"
                                class="form-select">
                            <option value="Active"
                                    selected="@(Model.StatusFilter == "Active")">
                                Active Students
                            </option>

                            <option value="Inactive"
                                    selected="@(Model.StatusFilter == "Inactive")">
                                Inactive Students
                            </option>

                            <option value="All"
                                    selected="@(Model.StatusFilter == "All")">
                                All Students
                            </option>
                        </select>
                    </div>

                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Search / Filter
                    </button>

                    <a asp-page="/Students/Index"
                       class="btn btn-outline-secondary">
                        Reset Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Student Records -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Registered Students</h2>

            <span class="badge bg-secondary">
                Records: @Model.Students.Count
            </span>
        </div>

        <div class="card-body">

            @if (Model.Students.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No students match your search or filter criteria.
                    Try changing your filters or select Reset Filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.StudentId</td>
                                    <td>@student.StudentName</td>

                                    <td>
                                        @(student.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")
                                    </td>

                                    <td>@(student.Gender ?? "—")</td>
                                    <td>@(student.Email ?? "—")</td>
                                    <td>@(student.Phone ?? "—")</td>

                                    <!-- Status Badge -->
                                    <td>
                                        @if (student.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">

                                            <a asp-page="/Students/Edit"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-page="/Students/Delete"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="ToggleStatus"
                                                  asp-route-id="@student.StudentId"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to @(student.IsActive ? "deactivate" : "reactivate") this student?');">

                                                <input type="hidden"
                                                       name="SearchTerm"
                                                       value="@Model.SearchTerm" />

                                                <input type="hidden"
                                                       name="AssignmentFilter"
                                                       value="@Model.AssignmentFilter" />

                                                <input type="hidden"
                                                       name="StatusFilter"
                                                       value="@Model.StatusFilter" />

                                                @if (student.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-warning">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-success">
                                                        Reactivate
                                                    </button>
                                                }

                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>